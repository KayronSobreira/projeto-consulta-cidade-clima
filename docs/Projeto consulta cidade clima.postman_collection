      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//verifica se o nome da cidade é Fortaleza\r",
              "pm.test(\"Verifica se o nome da cidade é Fortaleza\", function () {\r",
              "    pm.expect(pm.response.json().nome).to.eql(\"Fortaleza\");\r",
              "    });\r",
              "\r",
              "//verifica se o estado da cidade é CE\r",
              "pm.test(\"Verifica se o estado da cidade é CE\", function () {\r",
              "    pm.expect(pm.response.json().estado).to.eql(\"CE\");\r",
              "    });\r",
              "\r",
              "//verifica se os dados da clima estão presentes\r",
              "pm.test(\"Verifica se os dados da clima estão presentes\", function () {\r",
              "    pm.expect(pm.response.json().clima).to.have.property(\"condicao\");\r",
              "    pm.expect(pm.response.json().clima).to.have.property(\"condicao_desc\");\r",
              "    pm.expect(pm.response.json().clima).to.have.property(\"min\");\r",
              "    pm.expect(pm.response.json().clima).to.have.property(\"max\");\r",
              "    pm.expect(pm.response.json().clima).to.have.property(\"indice_uv\");\r",
              "});\r",
              "\r",
              "//verifica se a data de consulta está condizente\r",
              "pm.test(\"Verifica se a data de consulta está condizente\", function () {\r",
              "    const dataAtual = new Date();\r",
              "    const dataConsulta = new Date(pm.response.json().consultado_em);\r",
              "    pm.expect(dataConsulta).to.be.at.most(dataAtual);\r",
